{
  "manifest_version": 3,
  "name": "Nekkora Studio — Inspector",
  "short_name": "Nekkora Inspector",
  "version": "0.4.0",
  "description": "Interpretação estrutural e semântica de páginas (Nekkora Studio): laboratório local e sites http/https autorizados pelo usuário. Núcleo de análise em Java 21 via Native Messaging.",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Nekkora Inspector",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "src/ui/panel.html"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "nativeMessaging",
    "sidePanel",
    "storage",
    "scripting",
    "webNavigation",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "src/shared/tokens.js",
        "src/shared/privacy.js",
        "src/content/ns.js",
        "src/shared/interaction-normalizer.js",
        "src/content/node-registry.js",
        "src/content/sensitivity.js",
        "src/content/capture.js",
        "src/content/mutation-tracker.js",
        "src/content/locator-runner.js",
        "src/content/highlighter.js",
        "src/content/inspector.js",
        "src/shared/feedback-rules.js",
        "src/content/feedback-observer.js",
        "src/content/interaction-recorder.js",
        "src/content/content-main.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
