<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.nekkora</groupId>
    <artifactId>nekkora-extension-chrome-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>nekkora-integration-tests</artifactId>
  <name>Nekkora Integration Tests</name>
  <description>Homologação no Chrome real (Chrome for Testing): extensão + página de laboratório + host Java.</description>

  <properties>
    <!-- Matriz gerada pela execução: integration (padrão) ou real-web (-Suite real). -->
    <nekkora.matrix.phase>integration</nekkora.matrix.phase>
    <maven.deploy.skip>true</maven.deploy.skip>
    <nekkora.headless>false</nekkora.headless>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.nekkora</groupId>
      <artifactId>nekkora-lab-server</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.nekkora</groupId>
      <artifactId>nekkora-native-host</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.seleniumhq.selenium</groupId>
      <artifactId>selenium-java</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- Somente testes de contrato (sem navegador) rodam no ciclo padrão. -->
          <includes>
            <include>**/*Test.java</include>
          </includes>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>integration</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <includes>
                <include>**/*IT.java</include>
              </includes>
              <!-- NEKKORA-REAL-001: a homologação em página REAL (internet) só roda quando pedida explicitamente
                   (scripts/run-tests.ps1 -Suite real, que seleciona a classe por -Dit.test). -->
              <excludes>
                <exclude>**/*LiveWebIT.java</exclude>
              </excludes>
              <runOrder>alphabetical</runOrder>
              <systemPropertyVariables>
                <nekkora.repo>${project.basedir}/..</nekkora.repo>
                <nekkora.headless>${nekkora.headless}</nekkora.headless>
                <nekkora.phase>${nekkora.matrix.phase}</nekkora.phase>
              </systemPropertyVariables>
              <trimStackTrace>false</trimStackTrace>
            </configuration>
            <executions>
              <execution>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
